{
    "config": {
        "step": {
            "user": {
                "title": "Warmondo heat pump",
                "description": "Adds a Warmondo heat pump by MULTIBETON GmbH. Home Assistant talks to the Modbus TCP gateway at the controller, not to the heat pump directly.\n\nIn most cases the gateway's IP address is all it takes. Guide: [setup help]({docs_url}). MULTIBETON service: {support_phone}, {support_email}.",
                "data": {
                    "name": "Name",
                    "model": "Model",
                    "host": "Gateway IP address"
                },
                "data_description": {
                    "name": "Optional. Becomes the device name. Only needed when more than one heat pump is added.",
                    "model": "The model from the type plate (WM-S to WM-XL). The controller does not report it, so pick it here.",
                    "host": "The fixed IP address of the Modbus TCP gateway, for example 192.168.1.50. It is shown in the gateway's web interface or in your router's device list."
                },
                "sections": {
                    "advanced": {
                        "name": "Advanced",
                        "description": "Only change these if the gateway is set up differently from the usual.",
                        "data": {
                            "port": "Port",
                            "unit_id": "Controller Modbus address",
                            "framer": "Wire framing",
                            "read_only": "Read only"
                        },
                        "data_description": {
                            "port": "TCP port of the gateway. Usually 502.",
                            "unit_id": "Modbus address of the controller behind the gateway. Usually 1.",
                            "framer": "\"socket\" if the gateway speaks Modbus TCP (usual), \"rtu\" if it passes the controller's frames through. If the connection fails, try the other one first.",
                            "read_only": "Creates no switches, setpoints, selects or buttons. The plant cannot be adjusted from Home Assistant - for demonstration rigs or monitoring only."
                        }
                    }
                }
            },
            "reconfigure": {
                "title": "Reconfigure Warmondo heat pump",
                "description": "Change the settings of this heat pump. Devices, entities and their IDs are kept, so automations and dashboards keep working.\n\nGuide: [setup help]({docs_url}).",
                "data": {
                    "name": "Name",
                    "model": "Model",
                    "host": "Gateway IP address"
                },
                "data_description": {
                    "name": "Optional. Becomes the device name. Only needed when more than one heat pump is added.",
                    "model": "The model from the type plate (WM-S to WM-XL).",
                    "host": "The fixed IP address of the Modbus TCP gateway."
                },
                "sections": {
                    "advanced": {
                        "name": "Advanced",
                        "description": "Only change these if the gateway is set up differently from the usual.",
                        "data": {
                            "port": "Port",
                            "unit_id": "Controller Modbus address",
                            "framer": "Wire framing",
                            "read_only": "Read only"
                        },
                        "data_description": {
                            "port": "TCP port of the gateway. Usually 502.",
                            "unit_id": "Modbus address of the controller behind the gateway. Usually 1.",
                            "framer": "\"socket\" if the gateway speaks Modbus TCP (usual), \"rtu\" if it passes the controller's frames through.",
                            "read_only": "Creates no switches, setpoints, selects or buttons. The plant cannot be adjusted from Home Assistant."
                        }
                    }
                }
            }
        },
        "error": {
            "cannot_connect": "Cannot reach the controller. Check that the gateway is powered and reachable at this IP address. If it is, try the other wire framing under \"Advanced\".",
            "unknown": "Unexpected error. Check the log or contact MULTIBETON service."
        },
        "abort": {
            "already_configured": "This heat pump is already configured.",
            "reconfigure_successful": "The settings have been saved."
        }
    },
